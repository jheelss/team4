# Copy this file to .env for local development.
# The microservices import a root .env file when launched from the repository
# root, microservices directory, or an individual service directory.
# Never commit .env or real passwords.

# Shared local MySQL connection.
# Services map to identity_db, policyholder_db, product_db, policy_db,
# premium_db, claims_db, and statement_db.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-local-mysql-password

# Optional per-service least-privilege accounts.
# Leave these commented while using MYSQL_USER/MYSQL_PASSWORD.
# IDENTITY_DB_USERNAME=securelife_identity
# IDENTITY_DB_PASSWORD=replace-with-identity-password
# POLICYHOLDER_DB_USERNAME=securelife_policyholder
# POLICYHOLDER_DB_PASSWORD=replace-with-policyholder-password
# PRODUCT_DB_USERNAME=securelife_product
# PRODUCT_DB_PASSWORD=replace-with-product-password
# POLICY_DB_USERNAME=securelife_policy
# POLICY_DB_PASSWORD=replace-with-policy-password
# PREMIUM_DB_USERNAME=securelife_premium
# PREMIUM_DB_PASSWORD=replace-with-premium-password
# CLAIMS_DB_USERNAME=securelife_claims
# CLAIMS_DB_PASSWORD=replace-with-claims-password
# STATEMENT_DB_USERNAME=securelife_statement
# STATEMENT_DB_PASSWORD=replace-with-statement-password

# Use the same high-entropy secret for identity-service and api-gateway.
JWT_SECRET=replace-with-at-least-32-random-bytes

# Eureka credentials are shared by the registry and every client.
# Use a long URL-safe value because the password is embedded in a URL.
EUREKA_USERNAME=registry-client
EUREKA_PASSWORD=replace-with-a-long-url-safe-random-secret
EUREKA_HOST=localhost
EUREKA_PORT=8761
EUREKA_BIND_ADDRESS=127.0.0.1
EUREKA_PREFER_IP_ADDRESS=false
